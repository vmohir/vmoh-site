---
import Layout from "../layouts/Layout.astro";
import wordsUrl from "../words.json?url";
---

<Layout title="دور | واژه‌بازی" preloadJsonHref={wordsUrl}>
  <div id="app"></div>
</Layout>

<script>
  // Skip Astro's islands runtime — a single root component doesn't need the
  // inline astro-island element, the islands client.js, or the renderer
  // chunk, so mount Preact directly.
  import { h, render } from "preact";
  import WordGuessingApp from "../games/wordGuessing/WordGuessingApp";

  const root = document.getElementById("app");
  if (root) {
    render(
      h(WordGuessingApp, {
        config: {
          title: "دور",
          instructions:
            "کلمه رو با حرف زدن توضیح بده، بدون اینکه خود کلمه یا هم‌خانواده‌هاش رو بگی، تا تیمت حدس بزنه.",
        },
      }),
      root,
    );
  }
</script>
